# ── Google Gemini (SQL generation + semantic search embeddings) ────────────────
# Get a FREE key at https://aistudio.google.com → "Get API key"
GOOGLE_API_KEY=your_google_api_key_here
# Optional: override model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── TMDB (on-demand movie metadata: descriptions, posters) ─────────────────────
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Ollama fallback (used only when GOOGLE_API_KEY is not set) ─────────────────
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=sqlcoder:7b
