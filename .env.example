# ── Groq (LLM: intent extraction, title suggestions, reranking) ───────────────
# Get a FREE key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Optional: override model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ── TMDB (movie metadata: descriptions, posters, search) ──────────────────────
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Qdrant (vector DB for semantic search) ────────────────────────────────────
# Start locally: docker compose up -d
# Then build the index: python scripts/build_index.py
QDRANT_URL=http://localhost:6333

# ── Ollama fallback (used only when GROQ_API_KEY is not set) ──────────────────
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=sqlcoder:7b
